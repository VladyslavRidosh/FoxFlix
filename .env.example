# Copy to .env before running Docker Compose if you want to customize local values.
POSTGRES_PASSWORD=foxflix_dev_password
# Optional. Obtain a TMDB Read Access Token from your TMDB account to enable live movie/series catalogues.
TMDB_READ_ACCESS_TOKEN=
# Optional initial admin. Leave blank to disable automatic admin creation.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
