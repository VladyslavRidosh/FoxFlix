
@model Foxflix.Web.Controllers.MovieController.MovieDto

@{
    var publicApiBaseUrl = (Configuration["ApiSettings:PublicBaseUrl"] ?? Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7283/").TrimEnd('/');
    var publicApiBaseUrlJson = System.Text.Json.JsonSerializer.Serialize(publicApiBaseUrl);
    ViewData["Title"] = "Трейлери";
}

<section class="trailers-page">
    <div class="trailers-container">

        <header class="trailers-header">
            <div class="trailers-heading-content">
                <div class="trailers-eyebrow">
                    <span class="trailers-eyebrow-line"></span>
                    FOXFLIX CINEMA
                </div>

                <h1>
                    Відчуй кіно<br />
                    <span>ще до перегляду.</span>
                </h1>

                <p>
                    Дивись трейлери, відкривай нові історії
                    та знаходь фільм для наступного вечора.
                </p>

                <div class="trailers-header-stats">
                    <div>
                        <span class="trailers-stat-icon">▶</span>
                        <span>Офіційні трейлери</span>
                    </div>

                    <div>
                        <span class="trailers-stat-icon">✦</span>
                        <span>Колекція TMDB</span>
                    </div>
                </div>
            </div>

            <div class="trailers-hero-art" aria-hidden="true">
                <div class="trailers-art-orbit orbit-one"></div>
                <div class="trailers-art-orbit orbit-two"></div>
                <div class="trailers-art-orbit orbit-three"></div>
                <div class="trailers-art-glow"></div>

                <div class="trailers-art-play">▶</div>

                <span class="trailers-art-caption">YOUR NEXT MOVIE</span>
            </div>

            <div class="trailers-header-bottom">
                <span>01 / DISCOVER</span>
                <span>ЗНАЙДИ СВОЮ НАСТУПНУ ІСТОРІЮ</span>
            </div>
        </header>

        <section class="trailers-discovery">
            <div class="trailers-section-heading">
                <div>
                    <span class="trailers-section-label">ТВОЯ НАСТУПНА ЗНАХІДКА</span>
                    <h2>Досліджуй трейлери<span>.</span></h2>
                </div>

                <div class="trailers-results-label">
                    <span class="trailers-results-dot"></span>
                    <span>TMDB COLLECTION</span>
                </div>
            </div>

            <form id="trailerSearchForm" class="trailers-toolbar">
                <div class="trailers-search-icon" aria-hidden="true">⌕</div>

                <input id="trailerSearch"
                       type="search"
                       placeholder="Назва фільму..."
                       autocomplete="off"
                       aria-label="Пошук фільмів" />

                <button type="submit" id="searchButton">
                    <span>Знайти</span>
                    <span class="trailers-search-arrow">→</span>
                </button>
            </form>

            <div class="trailers-toolbar-bottom">
                <span>ПОПУЛЯРНЕ ТА НОВЕ КІНО</span>
                <button type="button" id="resetSearch" class="trailers-reset">
                    Скинути пошук <span>↺</span>
                </button>
            </div>
        </section>

        <div id="trailersStatus"
             class="trailers-status"
             role="status"
             aria-live="polite">
            <span class="trailers-status-dot"></span>
            Завантажуємо фільми...
        </div>

        <div id="trailersGrid" class="trailers-grid"></div>

        <div id="trailersEmpty" class="trailers-empty" hidden>
            <div class="trailers-empty-icon">⌕</div>
            <h2>Нічого не знайдено</h2>
            <p>Спробуй іншу назву або повернися до популярних фільмів.</p>
            <button type="button" id="emptyReset">Показати популярне</button>
        </div>

        <footer class="trailers-footer">
            <div class="trailers-footer-brand">
                FOXFLIX<span>.</span>
            </div>

            <p>Велике кіно починається з маленького вибору.</p>

            <span class="trailers-footer-meta">POWERED BY TMDB</span>
        </footer>

    </div>
</section>

<div id="trailerModal"
     class="trailer-modal"
     aria-hidden="true"
     role="dialog"
     aria-modal="true"
     aria-label="Перегляд трейлера">

    <button type="button"
            id="closeTrailerBackdrop"
            class="trailer-modal-backdrop"
            aria-label="Закрити вікно"></button>

    <div class="trailer-modal-content">
        <div class="trailer-modal-header">
            <div>
                <span class="trailer-modal-label">FOXFLIX CINEMA</span>
                <h2 id="trailerModalTitle">Трейлер фільму</h2>
            </div>

            <button type="button"
                    id="closeTrailer"
                    class="trailer-close"
                    aria-label="Закрити трейлер">×</button>
        </div>

        <div class="trailer-frame">
            <iframe id="trailerFrame"
                    src=""
                    title="Трейлер фільму"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen></iframe>
        </div>

        <div class="trailer-modal-footer">
            <span class="trailer-modal-footer-dot"></span>
            ОФІЦІЙНИЙ ВІДЕОТРЕЙЛЕР
        </div>
    </div>
</div>

<style>
    .trailers-page {
        --tr-red: #e50914;
        --tr-red-bright: #ff303a;
        --tr-bg: #080808;
        --tr-card: #111111;
        --tr-border: #262626;
        --tr-muted: #898989;

        min-height: 100vh;
        padding: 38px 28px 35px;
        overflow: hidden;
        background:
            radial-gradient(ellipse at 78% 0%, rgba(229, 9, 20, .08), transparent 34%),
            var(--tr-bg);
        color: #f5f5f5;
    }

    .trailers-page *,
    .trailer-modal * {
        box-sizing: border-box;
    }

    .trailers-container {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
    }

    /* HEADER */

    .trailers-header {
        position: relative;
        display: flex;
        min-height: 340px;
        overflow: hidden;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #302020;
        border-radius: 16px;
        background:
            linear-gradient(100deg, #160d0e 0%, #100c0d 48%, #17090b 100%);
    }

    .trailers-heading-content {
        position: relative;
        z-index: 2;
        width: 62%;
        padding: 35px 42px 53px;
    }

    .trailers-eyebrow {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #ff626a;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2.8px;
    }

    .trailers-eyebrow-line {
        width: 24px;
        height: 2px;
        background: var(--tr-red);
    }

    .trailers-header h1 {
        margin: 21px 0 15px;
        font-size: clamp(36px, 4.4vw, 61px);
        line-height: 1.07;
        font-weight: 850;
        letter-spacing: -2.3px;
    }

    .trailers-header h1 span {
        color: #ff303a;
    }

    .trailers-heading-content > p {
        max-width: 470px;
        margin: 0;
        color: #aaa;
        font-size: 13px;
        line-height: 1.9;
    }

    .trailers-header-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 25px;
    }

    .trailers-header-stats > div {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #c2baba;
        font-size: 10px;
    }

    .trailers-stat-icon {
        color: #ff424b;
        font-size: 14px;
    }

    .trailers-hero-art {
        position: absolute;
        top: 0;
        right: 0;
        width: 45%;
        height: 100%;
        pointer-events: none;
    }

    .trailers-art-orbit {
        position: absolute;
        top: 46%;
        left: 52%;
        aspect-ratio: 1;
        border: 1px solid rgba(255, 80, 90, .18);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }

    .orbit-one {
        width: 290px;
    }

    .orbit-two {
        width: 225px;
        border-color: rgba(255, 80, 90, .24);
    }

    .orbit-three {
        width: 160px;
        border-color: rgba(255, 80, 90, .32);
    }

    .trailers-art-glow {
        position: absolute;
        top: 46%;
        left: 52%;
        width: 170px;
        height: 170px;
        border-radius: 50%;
        background: rgba(229, 9, 20, .16);
        filter: blur(50px);
        transform: translate(-50%, -50%);
    }

    .trailers-art-play {
        position: absolute;
        top: 46%;
        left: 52%;
        display: grid;
        width: 90px;
        height: 90px;
        place-items: center;
        padding-left: 5px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 28px;
        background: linear-gradient(145deg, #f21a25, #83050d);
        box-shadow: 0 20px 55px rgba(229, 9, 20, .3);
        color: white;
        font-size: 27px;
        transform: translate(-50%, -50%) rotate(-9deg);
    }

    .trailers-art-caption {
        position: absolute;
        top: 77%;
        left: 52%;
        color: rgba(255,255,255,.4);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
        transform: translateX(-50%);
        white-space: nowrap;
    }

    .trailers-header-bottom {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 14px 25px;
        border-top: 1px solid rgba(255,255,255,.07);
        color: #777;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .trailers-header-bottom span:first-child {
        color: #ff434c;
    }

    /* DISCOVERY */

    .trailers-discovery {
        margin-top: 44px;
    }

    .trailers-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .trailers-section-label {
        color: #e50914;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .trailers-section-heading h2 {
        margin: 8px 0 0;
        font-size: clamp(22px, 3vw, 30px);
        font-weight: 800;
        letter-spacing: -.7px;
    }

    .trailers-section-heading h2 span {
        color: var(--tr-red);
    }

    .trailers-results-label {
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 5px;
        color: #777;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    .trailers-results-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #51d88a;
        box-shadow: 0 0 9px rgba(81,216,138,.35);
    }

    .trailers-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 60px;
        padding: 7px 8px 7px 17px;
        border: 1px solid #292929;
        border-radius: 11px;
        background: #111;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .trailers-toolbar:focus-within {
        border-color: rgba(229, 9, 20, .7);
        box-shadow: 0 0 0 3px rgba(229, 9, 20, .07);
    }

    .trailers-search-icon {
        color: #e50914;
        font-size: 28px;
        line-height: 1;
    }

    .trailers-toolbar input {
        flex: 1;
        width: 100%;
        min-width: 0;
        padding: 12px 3px;
        border: 0;
        outline: none;
        background: transparent;
        color: white;
        font: inherit;
        font-size: 13px;
    }

    .trailers-toolbar input::placeholder {
        color: #777;
    }

    .trailers-toolbar input::-webkit-search-cancel-button {
        cursor: pointer;
    }

    .trailers-toolbar button,
    .trailers-empty button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        min-height: 44px;
        padding: 0 19px;
        border: 1px solid var(--tr-red);
        border-radius: 8px;
        background: var(--tr-red);
        color: white;
        font: inherit;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

    .trailers-toolbar button:hover,
    .trailers-empty button:hover {
        border-color: #ff303a;
        background: #ff303a;
        box-shadow: 0 5px 20px rgba(229, 9, 20, .18);
    }

    .trailers-search-arrow {
        font-size: 17px;
    }

    .trailers-toolbar-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
        color: #686868;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.2px;
    }

    .trailers-reset {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 0;
        border: 0;
        background: transparent;
        color: #aaa;
        font: inherit;
        font-size: 10px;
        letter-spacing: 0;
        cursor: pointer;
        transition: color .2s ease;
    }

    .trailers-reset:hover {
        color: #ff424b;
    }

    .trailers-reset span {
        font-size: 15px;
    }

    /* STATUS */

    .trailers-status {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 45px;
        margin: 17px 0 12px;
        color: #929292;
        font-size: 12px;
    }

    .trailers-status-dot {
        width: 7px;
        height: 7px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e50914;
    }

    .trailers-status.loading .trailers-status-dot {
        animation: trailerPulse 1s infinite alternate;
    }

    .trailers-status.error .trailers-status-dot {
        background: #ff5c62;
    }

    .trailers-status.success .trailers-status-dot {
        background: #51d88a;
    }

    @@keyframes trailerPulse {
        from { opacity: .35; }
        to { opacity: 1; }
    }

    /* MOVIE CARDS */

    .trailers-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 20px;
    }

    .trailer-card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid #252525;
        border-radius: 11px;
        background: linear-gradient(155deg, #141414, #0e0e0e);
        transition: transform .25s ease, border-color .25s ease,
            box-shadow .25s ease;
        animation: trailerAppear .35s ease both;
    }

    .trailer-card:hover {
        z-index: 1;
        transform: translateY(-5px);
        border-color: rgba(229, 9, 20, .75);
        box-shadow: 0 12px 35px rgba(0,0,0,.25);
    }

    @@keyframes trailerAppear {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .trailer-poster {
        position: relative;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background:
            radial-gradient(ellipse at center, #2a1516, #151515 75%);
    }

    .trailer-poster img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .45s ease, opacity .25s ease;
    }

    .trailer-card:hover .trailer-poster img {
        transform: scale(1.045);
    }

    .trailer-poster-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        color: #e50914;
        font-size: 42px;
        font-weight: 800;
    }

    .trailer-poster::after {
        position: absolute;
        z-index: 1;
        inset: 45% 0 0;
        background: linear-gradient(transparent, rgba(0,0,0,.68));
        content: "";
        pointer-events: none;
    }

    .trailer-play {
        position: absolute;
        z-index: 2;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        background: transparent;
        color: white;
        cursor: pointer;
    }

    .trailer-play span {
        display: grid;
        width: 54px;
        height: 54px;
        place-items: center;
        padding-left: 3px;
        border: 1px solid rgba(255,255,255,.7);
        border-radius: 50%;
        background: rgba(229, 9, 20, .91);
        box-shadow: 0 4px 25px rgba(0,0,0,.4);
        font-size: 18px;
        opacity: 0;
        transform: scale(.85);
        transition: opacity .2s ease, transform .2s ease,
            background .2s ease;
    }

    .trailer-card:hover .trailer-play span,
    .trailer-play:focus-visible span {
        opacity: 1;
        transform: scale(1);
    }

    .trailer-play:hover span {
        background: #ff303a;
    }

    .trailer-poster-badge {
        position: absolute;
        z-index: 2;
        top: 10px;
        left: 10px;
        padding: 6px 8px;
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 5px;
        background: rgba(0,0,0,.7);
        color: #eee;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .8px;
        backdrop-filter: blur(8px);
    }

    .trailer-info {
        padding: 15px 14px 16px;
    }

    .trailer-info h2 {
        display: -webkit-box;
        min-height: 40px;
        overflow: hidden;
        margin: 0 0 10px;
        color: #f3f3f3;
        font-size: 14px;
        font-weight: 750;
        line-height: 1.45;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .trailer-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        margin-bottom: 11px;
        color: #a7a7a7;
        font-size: 10px;
    }

    .trailer-year {
        color: #aaa;
    }

    .trailer-rating {
        color: #ffbd55;
    }

    .trailer-overview {
        display: -webkit-box;
        min-height: 54px;
        overflow: hidden;
        margin: 0;
        color: #858585;
        font-size: 11px;
        line-height: 1.65;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .trailer-card-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
        margin-top: 15px;
        padding: 10px 0 0;
        border: 0;
        border-top: 1px solid #262626;
        background: transparent;
        color: #d4d4d4;
        font: inherit;
        font-size: 10px;
        font-weight: 750;
        text-align: left;
        cursor: pointer;
        transition: color .2s ease;
    }

    .trailer-card-action span:last-child {
        color: #e50914;
        font-size: 16px;
    }

    .trailer-card-action:hover {
        color: #ff4b52;
    }

    /* EMPTY STATE */

    .trailers-empty {
        padding: 65px 20px;
        border: 1px solid #272727;
        border-radius: 13px;
        background: #101010;
        text-align: center;
    }

    .trailers-empty[hidden] {
        display: none;
    }

    .trailers-empty-icon {
        display: grid;
        width: 65px;
        height: 65px;
        place-items: center;
        margin: 0 auto 20px;
        border: 1px solid #3b2020;
        border-radius: 18px;
        background: rgba(229,9,20,.08);
        color: #ff303a;
        font-size: 32px;
    }

    .trailers-empty h2 {
        margin: 0 0 10px;
        font-size: 23px;
    }

    .trailers-empty p {
        margin: 0 auto 22px;
        color: #929292;
        font-size: 12px;
        line-height: 1.7;
    }

    /* MODAL */

    .trailer-modal {
        position: fixed;
        z-index: 9999;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
        padding: 35px 22px;
    }

    .trailer-modal.open {
        display: flex;
    }

    .trailer-modal-backdrop {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        background: rgba(0,0,0,.94);
        cursor: default;
    }

    .trailer-modal-content {
        position: relative;
        z-index: 1;
        width: min(1080px, 100%);
        margin: auto;
        animation: trailerModalIn .22s ease both;
    }

    @@keyframes trailerModalIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.99);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .trailer-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 17px;
    }

    .trailer-modal-label {
        color: #e50914;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .trailer-modal-header h2 {
        margin: 7px 0 0;
        color: #f4f4f4;
        font-size: clamp(17px, 3vw, 25px);
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .trailer-close {
        display: grid;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        place-items: center;
        border: 1px solid #3b3b3b;
        border-radius: 50%;
        background: #161616;
        color: white;
        font: inherit;
        font-size: 27px;
        cursor: pointer;
        transition: .2s ease;
    }

    .trailer-close:hover {
        border-color: #e50914;
        background: #e50914;
        transform: rotate(90deg);
    }

    .trailer-frame {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 1px solid #333;
        border-radius: 12px;
        background: #000;
        box-shadow: 0 20px 80px rgba(0,0,0,.4);
    }

    .trailer-frame iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .trailer-modal-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        color: #777;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .trailer-modal-footer-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #e50914;
    }

    /* FOOTER */

    .trailers-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 55px;
        padding-top: 22px;
        border-top: 1px solid #242424;
    }

    .trailers-footer-brand {
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 900;
