    @@media (max-width: 380px) {
        .trailers-page {
            padding-right: 10px;
            padding-left: 10px;
        }

        .trailers-section-heading {
            flex-direction: column;
            gap: 10px;
        }

        .trailers-grid {
            gap: 9px;
        }

        .trailer-info {
            padding: 10px 8px;
        }

        .trailer-info h2 {
            font-size: 11px;
        }

        .trailer-poster-badge {
            top: 6px;
            left: 6px;
            padding: 5px;
            font-size: 7px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .trailers-page *,
        .trailer-modal * {
            animation-duration: .01ms !important;
            transition-duration: .01ms !important;
        }
    }
</style>

<script>
    (() => {
        const apiBaseUrl = @Html.Raw(publicApiBaseUrlJson);

        const grid = document.getElementById("trailersGrid");
        const statusElement = document.getElementById("trailersStatus");
        const searchInput = document.getElementById("trailerSearch");
        const searchForm = document.getElementById("trailerSearchForm");
        const resetSearchButton = document.getElementById("resetSearch");
        const emptyResetButton = document.getElementById("emptyReset");
        const emptyState = document.getElementById("trailersEmpty");

        const modal = document.getElementById("trailerModal");
        const trailerFrame = document.getElementById("trailerFrame");
        const trailerModalTitle = document.getElementById("trailerModalTitle");
        const closeTrailerButton = document.getElementById("closeTrailer");
        const closeBackdropButton = document.getElementById("closeTrailerBackdrop");

        let requestNumber = 0;
        let previousFocus = null;

        function setStatus(message, type = "") {
            statusElement.replaceChildren();

            const dot = document.createElement("span");
            dot.className = "trailers-status-dot";

            statusElement.append(dot, document.createTextNode(message));
            statusElement.className = "trailers-status";

            if (type) {
                statusElement.classList.add(type);
            }
        }

        function getYear(date) {
            if (!date || typeof date !== "string") {
                return "Рік невідомий";
            }

            const year = date.slice(0, 4);
            return /^\d{4}$/.test(year) ? year : "Рік невідомий";
        }

        function getRating(value) {
            const rating = Number(value);

            if (!Number.isFinite(rating) || rating <= 0) {
                return "Немає оцінки";
            }

            return rating.toFixed(1);
        }

        function makeMovieCard(movie, index) {
            const card = document.createElement("article");
            card.className = "trailer-card";
            card.style.animationDelay = `${Math.min(index * 35, 350)}ms`;

            const poster = document.createElement("div");
            poster.className = "trailer-poster";

            if (movie.posterPath) {
                const image = document.createElement("img");
                image.alt = movie.title || "Постер фільму";
                image.loading = "lazy";
                image.decoding = "async";
                image.src =
                    "https://image.tmdb.org/t/p/w500" + movie.posterPath;

                image.addEventListener("error", () => {
                    image.remove();

                    const placeholder = document.createElement("div");
                    placeholder.className = "trailer-poster-placeholder";
                    placeholder.textContent = "F";
                    placeholder.setAttribute("aria-label", "Постер недоступний");

                    poster.prepend(placeholder);
                }, { once: true });

                poster.append(image);
            } else {
                const placeholder = document.createElement("div");
                placeholder.className = "trailer-poster-placeholder";
                placeholder.textContent = "F";
                placeholder.setAttribute("aria-label", "Постер недоступний");

                poster.append(placeholder);
            }

            const badge = document.createElement("span");
            badge.className = "trailer-poster-badge";
            badge.textContent = "FOXFLIX";

            const playButton = document.createElement("button");
            playButton.type = "button";
            playButton.className = "trailer-play";
            playButton.setAttribute(
                "aria-label",
                `Дивитися трейлер: ${movie.title || "фільм"}`
            );

            const playIcon = document.createElement("span");
            playIcon.textContent = "▶";
            playButton.append(playIcon);

            playButton.addEventListener("click", () => {
                openMovieTrailer(movie.id, movie.title || "Трейлер фільму");
            });

            poster.append(badge, playButton);

            const info = document.createElement("div");
            info.className = "trailer-info";

            const title = document.createElement("h2");
            title.textContent = movie.title || "Без назви";

            const meta = document.createElement("div");
            meta.className = "trailer-meta";

            const year = document.createElement("span");
            year.className = "trailer-year";
            year.textContent = getYear(movie.releaseDate);

            const rating = document.createElement("span");
            rating.className = "trailer-rating";
            rating.textContent = "★ " + getRating(movie.voteAverage);

            meta.append(year, rating);

            const overview = document.createElement("p");
            overview.className = "trailer-overview";
            overview.textContent =
                movie.overview || "Опис цього фільму поки недоступний.";

            const action = document.createElement("button");
            action.type = "button";
            action.className = "trailer-card-action";

            const actionText = document.createElement("span");
            actionText.textContent = "Дивитися трейлер";

            const actionArrow = document.createElement("span");
            actionArrow.textContent = "→";

            action.append(actionText, actionArrow);

            action.addEventListener("click", () => {
                openMovieTrailer(movie.id, movie.title || "Трейлер фільму");
            });

            info.append(title, meta, overview, action);
            card.append(poster, info);

            return card;
        }

        async function loadMovies(searchTerm = "") {
            const currentRequest = ++requestNumber;
            const term = searchTerm.trim();

            grid.replaceChildren();
            emptyState.hidden = true;
            setStatus("Завантажуємо фільми...", "loading");

            const endpoint = term
                ? `/api/tmdb/search?query=${encodeURIComponent(term)}&page=1`
                : "/api/tmdb/popular?page=1";

            try {
                const response = await fetch(apiBaseUrl + endpoint);

                if (!response.ok) {
                    throw new Error("API повернув статус " + response.status);
                }

                const result = await response.json();

                if (currentRequest !== requestNumber) {
                    return;
                }

                const movies = Array.isArray(result.results)
                    ? result.results
                    : [];

                if (movies.length === 0) {
                    setStatus(
                        term
                            ? "За цим запитом фільмів не знайдено."
                            : "Популярні фільми поки недоступні."
                    );

                    emptyState.hidden = false;
                    return;
                }

                const fragment = document.createDocumentFragment();

                movies.forEach((movie, index) => {
                    fragment.append(makeMovieCard(movie, index));
                });

                grid.append(fragment);

                setStatus(
                    term
                        ? `Результати пошуку: ${movies.length} фільмів.`
                        : "Популярні фільми TMDB — обери трейлер для перегляду.",
                    "success"
                );
            } catch (error) {
                if (currentRequest !== requestNumber) {
                    return;
                }

                console.error("Не вдалося завантажити фільми:", error);

                setStatus(
                    "Не вдалося завантажити фільми. Перевір, чи запущений Foxflix.API.",
                    "error"
                );

                emptyState.hidden = true;
            }
        }

        async function openMovieTrailer(movieId, movieTitle) {
            if (!movieId) {
                setStatus("Не вдалося визначити фільм для трейлера.", "error");
                return;
            }

            previousFocus = document.activeElement;

            trailerModalTitle.textContent = movieTitle;
            trailerFrame.src = "";
            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            closeTrailerButton.focus();

            try {
                const response = await fetch(
                    `${apiBaseUrl}/api/tmdb/movie/${encodeURIComponent(movieId)}/videos`
                );

                if (!response.ok) {
                    throw new Error("API повернув статус " + response.status);
                }

                const result = await response.json();
                const videos = Array.isArray(result.results)
                    ? result.results
                    : [];

                const youtubeVideos = videos.filter(video =>
                    (video.site || "").toLowerCase() === "youtube" &&
                    video.key
                );

                const trailer =
                    youtubeVideos.find(video =>
                        (video.type || "").toLowerCase() === "trailer" &&
                        video.key
                    ) ||
                    youtubeVideos.find(video =>
                        (video.type || "").toLowerCase() === "teaser" &&
                        video.key
                    ) ||
                    youtubeVideos[0];

                if (!trailer) {
                    closeTrailer();
                    setStatus(
                        `Для фільму «${movieTitle}» трейлер не знайдено.`,
                        "error"
                    );
                    return;
                }

                if (!modal.classList.contains("open")) {
                    return;
                }

                trailerFrame.src =
                    "https://www.youtube-nocookie.com/embed/" +
                    encodeURIComponent(trailer.key) +
                    "?autoplay=1&rel=0";
            } catch (error) {
                console.error("Не вдалося завантажити трейлер:", error);

                closeTrailer();

                setStatus(
                    "Не вдалося завантажити трейлер. Перевір роботу API.",
                    "error"
                );
            }
        }

        function closeTrailer() {
            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");

            trailerFrame.src = "";
            document.body.style.overflow = "";

            if (previousFocus && typeof previousFocus.focus === "function") {
                previousFocus.focus();
            }
        }

        searchForm.addEventListener("submit", event => {
            event.preventDefault();
            loadMovies(searchInput.value);
        });

        resetSearchButton.addEventListener("click", () => {
            searchInput.value = "";
            loadMovies();
        });

        emptyResetButton.addEventListener("click", () => {
            searchInput.value = "";
            loadMovies();
        });

        closeTrailerButton.addEventListener("click", closeTrailer);
        closeBackdropButton.addEventListener("click", closeTrailer);

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && modal.classList.contains("open")) {
                closeTrailer();
            }
        });

        loadMovies();
    })();
</script>
