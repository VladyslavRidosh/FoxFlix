    /* RESPONSIVE */

    @@media (max-width: 1200px) {
        .trailers-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
        }

        .trailers-heading-content {
            width: 68%;
            padding-left: 30px;
        }

        .trailers-hero-art {
            width: 38%;
        }
    }

    @@media (max-width: 900px) {
        .trailers-page {
            padding: 28px 20px;
        }

        .trailers-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .trailers-header {
            min-height: 320px;
        }

        .trailers-heading-content {
            width: 75%;
            padding: 30px 25px 52px;
        }

        .trailers-header h1 {
            font-size: clamp(34px, 5.5vw, 48px);
        }

        .trailers-hero-art {
            right: -55px;
            opacity: .65;
        }

        .orbit-one {
            width: 230px;
        }

        .orbit-two {
            width: 175px;
        }

        .orbit-three {
            width: 125px;
        }

        .trailers-art-play {
            width: 70px;
            height: 70px;
        }
    }

    @@media (max-width: 650px) {
        .trailers-page {
            padding: 20px 13px 27px;
        }

        .trailers-header {
            min-height: 320px;
            border-radius: 12px;
        }

        .trailers-heading-content {
            width: 100%;
            padding: 27px 20px 57px;
        }

        .trailers-header h1 {
            max-width: 390px;
            font-size: clamp(34px, 8vw, 45px);
            letter-spacing: -1.6px;
        }

        .trailers-heading-content > p {
            max-width: 340px;
            font-size: 12px;
        }

        .trailers-header-stats {
            gap: 12px;
        }

        .trailers-header-stats > div {
            font-size: 9px;
        }

        .trailers-hero-art {
            right: -125px;
            width: 65%;
            opacity: .28;
        }

        .trailers-header-bottom {
            padding: 13px 15px;
            font-size: 8px;
        }

        .trailers-header-bottom span:last-child {
            max-width: 55%;
            text-align: right;
        }

        .trailers-discovery {
            margin-top: 32px;
        }

        .trailers-section-heading {
            align-items: flex-start;
            margin-bottom: 17px;
        }

        .trailers-section-heading h2 {
            font-size: 23px;
        }

        .trailers-results-label {
            padding-top: 3px;
            font-size: 8px;
        }

        .trailers-toolbar {
            min-height: 54px;
            gap: 8px;
            padding-left: 12px;
        }

        .trailers-toolbar input {
            font-size: 12px;
        }

        .trailers-toolbar button {
            gap: 8px;
            min-height: 40px;
            padding: 0 12px;
            font-size: 11px;
        }

        .trailers-toolbar-bottom {
