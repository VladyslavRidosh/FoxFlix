        }

        .trailer-overview {
            min-height: 50px;
            font-size: 10px;
        }

        .trailer-play span {
            width: 45px;
            height: 45px;
            font-size: 15px;
            opacity: 1;
            transform: scale(.92);
        }

        .trailer-card-action {
            margin-top: 12px;
            font-size: 9px;
        }

        .trailers-footer {
            flex-wrap: wrap;
            margin-top: 35px;
        }

        .trailers-footer p {
            order: 3;
            width: 100%;
        }

        .trailer-modal {
            padding: 18px 12px;
        }

        .trailer-modal-header {
            margin-bottom: 12px;
        }

        .trailer-close {
