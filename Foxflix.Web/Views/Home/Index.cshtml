
@model List<Foxflix.Web.Controllers.HomeController.MovieDto>

@{
    var publicApiBaseUrl = (Configuration["ApiSettings:PublicBaseUrl"] ?? Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7283/").TrimEnd('/');
    ViewData["Title"] = "Головна — FOXFLIX";

    var tmdbPopular =
        ViewBag.TmdbPopular as List<Foxflix.Web.Controllers.HomeController.TmdbHomeMovieDto>
        ?? new();

    var tmdbNew =
        ViewBag.TmdbNew as List<Foxflix.Web.Controllers.HomeController.TmdbHomeMovieDto>
        ?? new();

    var tmdbUpcoming =
        ViewBag.TmdbUpcoming as List<Foxflix.Web.Controllers.HomeController.TmdbHomeMovieDto>
        ?? new();

    var featuredTmdb = tmdbPopular.FirstOrDefault();
    var featuredMovie = Model.FirstOrDefault();

    var continueWatching =
        ViewBag.ContinueWatching as List<Foxflix.Web.Controllers.HomeController.ContinueWatchingDto>
        ?? new();

    var hasMovies = Model.Count > 0 || tmdbPopular.Count > 0
        || tmdbNew.Count > 0 || tmdbUpcoming.Count > 0;
}

<main class="fox-home">

    @* HERO *@
    @if (featuredTmdb is not null)
    {
        <section class="fox-hero">
            <div class="fox-hero-image"
                 style="background-image: url('@(string.IsNullOrWhiteSpace(featuredTmdb.FullBackdropUrl)
                                    ? featuredTmdb.FullPosterUrl
                                    : featuredTmdb.FullBackdropUrl)')">
            </div>

            <div class="fox-hero-overlay"></div>
            <div class="fox-hero-grain"></div>

            <div class="fox-container fox-hero-inner">
                <div class="fox-hero-copy">
                    <div class="fox-eyebrow">
                        <span class="fox-live-dot"></span>
                        ВИБІР FOXFLIX
                    </div>

                    <h1>@featuredTmdb.Title</h1>

                    <div class="fox-hero-meta">
                        <span>
                            @(featuredTmdb.ReleaseDate?.Length >= 4 == true
                                ? featuredTmdb.ReleaseDate[..4]
                                : "Рік невідомий")
                        </span>
                        <span class="fox-meta-divider"></span>
                        <span class="fox-rating">★ @featuredTmdb.Rating.ToString("0.0")</span>
                        <span class="fox-meta-divider"></span>
                        <span>@featuredTmdb.OriginalLanguage.ToUpperInvariant()</span>
                    </div>

                    <p class="fox-hero-description">
                        @(string.IsNullOrWhiteSpace(featuredTmdb.Overview)
                            ? "Відкрий сторінку фільму, щоб дізнатися більше."
                            : featuredTmdb.Overview)
                    </p>

                    <div class="fox-hero-actions">
                        <a asp-controller="Catalog"
                           asp-action="Details"
                           asp-route-id="@featuredTmdb.Id"
                           class="fox-btn fox-btn-red">
                            <span class="fox-btn-icon">▶</span>
                            Детальніше
                        </a>

                        <a asp-controller="Catalog"
                           asp-action="Index"
                           class="fox-btn fox-btn-glass">
                            Увесь каталог <span>↗</span>
                        </a>
                    </div>

                    <div class="fox-hero-caption">
                        <span class="fox-caption-line"></span>
                        <span>ТВОЯ НАСТУПНА ІСТОРІЯ ПОЧИНАЄТЬСЯ ТУТ</span>
                    </div>
                </div>

                <div class="fox-hero-index">
                    <span>01</span>
                    <span class="fox-index-line"></span>
                    <span>FOXFLIX</span>
                </div>
            </div>
        </section>
    }
    else if (featuredMovie is not null)
    {
        <section class="fox-hero">
            <div class="fox-hero-image"
                 style="background-image: url('@(string.IsNullOrWhiteSpace(featuredMovie.BackdropUrl)
                                    ? $"{publicApiBaseUrl}/api/movies/{featuredMovie.Id}/poster"
                                    : featuredMovie.BackdropUrl)')">
            </div>

            <div class="fox-hero-overlay"></div>

            <div class="fox-container fox-hero-inner">
                <div class="fox-hero-copy">
                    <div class="fox-eyebrow">
                        <span class="fox-live-dot"></span>
                        FOXFLIX ORIGINAL
                    </div>

                    <h1>@featuredMovie.Title</h1>

                    <div class="fox-hero-meta">
                        <span>@featuredMovie.ReleaseYear</span>
                        <span class="fox-meta-divider"></span>
                        <span>@featuredMovie.AgeRating+</span>
                        <span class="fox-meta-divider"></span>
                        <span>@featuredMovie.DurationMinutes хв</span>
                        <span class="fox-meta-divider"></span>
                        <span class="fox-rating">★ @featuredMovie.Rating</span>
                    </div>

                    <p class="fox-hero-description">@featuredMovie.Description</p>

                    <div class="fox-hero-actions">
                        <a asp-controller="Movie"
                           asp-action="Index"
                           asp-route-id="@featuredMovie.Id"
                           class="fox-btn fox-btn-red">
                            <span class="fox-btn-icon">▶</span>
                            Дивитися
                        </a>

                        <a asp-controller="Catalog"
                           asp-action="Index"
                           class="fox-btn fox-btn-glass">
                            Увесь каталог <span>↗</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    }

    <div class="fox-container fox-main-content">

        @* QUICK NAVIGATION *@
        <div class="fox-discovery-bar">
            <div class="fox-discovery-title">
                <span class="fox-discovery-mark"></span>
                <span>ТВІЙ КІНОПРОСТІР</span>
            </div>

            <nav class="fox-discovery-links" aria-label="Розділи головної сторінки">
                <a href="#new-releases">Новинки</a>
                <a href="#trending">Популярне</a>
                <a href="#coming-soon">Скоро</a>
                @if (continueWatching.Count > 0)
                {
                    <a href="#continue-watching">Продовжити</a>
                }
            </nav>

            <a asp-controller="Catalog" asp-action="Index" class="fox-discovery-all">
                Каталог <span>↗</span>
            </a>
        </div>

        @* NEW RELEASES *@
        @if (tmdbNew.Count > 0)
        {
            <section class="fox-section" id="new-releases">
                <div class="fox-section-heading">
                    <div class="fox-section-title-wrap">
                        <span class="fox-section-kicker">JUST RELEASED</span>
                        <h2>Новинки <span>кіно</span></h2>
                    </div>

                    <div class="fox-section-right">
                        <a asp-controller="Catalog" asp-action="Index" class="fox-see-all">
                            Більше фільмів <span>→</span>
                        </a>
                        <div class="fox-carousel-controls">
                            <button type="button" aria-label="Прокрутити назад"
                                    onclick="foxScroll('new-carousel', -1)">
                                ‹
                            </button>
                            <button type="button" aria-label="Прокрутити вперед"
                                    onclick="foxScroll('new-carousel', 1)">
                                ›
                            </button>
                        </div>
                    </div>
                </div>

                <div class="fox-carousel" id="new-carousel">
                    @foreach (var movie in tmdbNew.Take(20))
                    {
                        <a asp-controller="Catalog"
                           asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="fox-movie-card">

                            <div class="fox-poster">
                                @if (!string.IsNullOrWhiteSpace(movie.FullPosterUrl))
                                {
                                    <img src="@movie.FullPosterUrl" alt="@movie.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="fox-poster-placeholder">FOXFLIX</div>
                                }

                                <div class="fox-poster-hover">
                                    <span class="fox-play-button">▶</span>
                                </div>

                                <span class="fox-card-tag">НОВИНКА</span>
                            </div>

                            <div class="fox-card-info">
                                <h3>@movie.Title</h3>
                                <div class="fox-card-meta">
                                    <span>
                                        @(movie.ReleaseDate?.Length >= 4 == true
                                            ? movie.ReleaseDate[..4]
                                            : "—")
                                    </span>
                                    <span class="fox-card-rating">★ @movie.Rating.ToString("0.0")</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        @* TRENDING *@
        @if (tmdbPopular.Count > 0)
        {
            <section class="fox-section" id="trending">
                <div class="fox-section-heading">
                    <div class="fox-section-title-wrap">
                        <span class="fox-section-kicker">EVERYONE IS WATCHING</span>
                        <h2>Популярне <span>сьогодні</span></h2>
                    </div>

                    <div class="fox-section-right">
                        <a asp-controller="Catalog" asp-action="Index" class="fox-see-all">
                            Увесь каталог <span>→</span>
                        </a>
                        <div class="fox-carousel-controls">
                            <button type="button" aria-label="Прокрутити назад"
                                    onclick="foxScroll('popular-carousel', -1)">
                                ‹
                            </button>
                            <button type="button" aria-label="Прокрутити вперед"
                                    onclick="foxScroll('popular-carousel', 1)">
                                ›
                            </button>
                        </div>
                    </div>
                </div>

                <div class="fox-carousel" id="popular-carousel">
                    @foreach (var movie in tmdbPopular.Take(20))
                    {
                        <a asp-controller="Catalog"
                           asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="fox-movie-card">

                            <div class="fox-poster">
                                @if (!string.IsNullOrWhiteSpace(movie.FullPosterUrl))
                                {
                                    <img src="@movie.FullPosterUrl" alt="@movie.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="fox-poster-placeholder">FOXFLIX</div>
                                }

                                <div class="fox-poster-hover">
                                    <span class="fox-play-button">▶</span>
                                </div>
                            </div>

                            <div class="fox-card-info">
                                <h3>@movie.Title</h3>
                                <div class="fox-card-meta">
                                    <span>
                                        @(movie.ReleaseDate?.Length >= 4 == true
                                            ? movie.ReleaseDate[..4]
                                            : "—")
                                    </span>
                                    <span class="fox-card-rating">★ @movie.Rating.ToString("0.0")</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        @* UPCOMING *@
        @if (tmdbUpcoming.Count > 0)
        {
            <section class="fox-section" id="coming-soon">
                <div class="fox-section-heading">
                    <div class="fox-section-title-wrap">
                        <span class="fox-section-kicker">COMING SOON</span>
                        <h2>Скоро на <span>екранах</span></h2>
                    </div>

                    <div class="fox-carousel-controls">
                        <button type="button" aria-label="Прокрутити назад"
                                onclick="foxScroll('upcoming-carousel', -1)">
                            ‹
                        </button>
                        <button type="button" aria-label="Прокрутити вперед"
                                onclick="foxScroll('upcoming-carousel', 1)">
                            ›
                        </button>
                    </div>
                </div>

                <div class="fox-carousel" id="upcoming-carousel">
                    @foreach (var movie in tmdbUpcoming.Take(20))
                    {
                        <a asp-controller="Catalog"
                           asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="fox-movie-card">

                            <div class="fox-poster">
                                @if (!string.IsNullOrWhiteSpace(movie.FullPosterUrl))
                                {
                                    <img src="@movie.FullPosterUrl" alt="@movie.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="fox-poster-placeholder">FOXFLIX</div>
                                }

                                <div class="fox-poster-hover">
                                    <span class="fox-play-button">▶</span>
                                </div>

                                <span class="fox-card-tag fox-tag-muted">НЕЗАБАРОМ</span>
                            </div>

                            <div class="fox-card-info">
                                <h3>@movie.Title</h3>
                                <div class="fox-card-meta">
                                    <span>
                                        @(movie.ReleaseDate?.Length >= 4 == true
                                            ? movie.ReleaseDate[..4]
                                            : "Дата невідома")
                                    </span>
                                    <span class="fox-card-rating">★ @movie.Rating.ToString("0.0")</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }


        @if (!hasMovies)
        {
            <section class="fox-empty-state">
                <div class="fox-empty-icon">▶</div>
                <span class="fox-section-kicker">ЩЕ ТРОХИ ТЕРПІННЯ</span>
                <h2>Тут скоро буде <span>кіно</span></h2>
                <p>Зараз не вдалося завантажити фільми. Спробуй відкрити каталог.</p>
                <a asp-controller="Catalog" asp-action="Index" class="fox-btn fox-btn-red">
                    Відкрити каталог <span>↗</span>
                </a>
            </section>
        }

        <footer class="fox-home-footer">
            <div class="fox-footer-brand"><span>FOX</span>FLIX<span class="fox-footer-dot">.</span></div>
            <p>Твоя історія. Твій екран. Твоє кіно.</p>
            <a asp-controller="Catalog" asp-action="Index">Досліджувати каталог ↗</a>
        </footer>

    </div>
</main>

<style>
    .fox-home {
        --fox-bg: #080809;
        --fox-panel: #111114;
        --fox-panel-light: #18181d;
        --fox-red: #e50914;
        --fox-red-bright: #ff2633;
        --fox-text: #f7f7f8;
        --fox-muted: #9999a5;
        --fox-border: rgba(255,255,255,.09);
        position: relative;
        min-height: 100vh;
        padding-bottom: 30px;
        overflow: hidden;
        background: radial-gradient(ellipse at 50% 0%, rgba(229,9,20,.065), transparent 42%), var(--fox-bg);
        color: var(--fox-text);
    }

        .fox-home *,
        .fox-home *::before,
        .fox-home *::after {
            box-sizing: border-box;
        }

    .fox-container {
        width: min(1440px, calc(100% - 100px));
        margin-inline: auto;
    }

    /* HERO */

    .fox-hero {
        position: relative;
        display: flex;
        min-height: clamp(540px, 72vh, 790px);
        align-items: center;
        overflow: hidden;
        isolation: isolate;
        background: #101014;
    }

    .fox-hero-image {
        position: absolute;
        z-index: -3;
        inset: 0;
        background-position: center 30%;
        background-size: cover;
        transform: scale(1.025);
        animation: foxHeroReveal 1.2s ease-out both;
    }

    .fox-hero-overlay {
        position: absolute;
        z-index: -2;
        inset: 0;
        background: linear-gradient(90deg, rgba(8,8,9,.98) 0%, rgba(8,8,9,.91) 24%, rgba(8,8,9,.65) 48%, rgba(8,8,9,.17) 76%, rgba(8,8,9,.3) 100%), linear-gradient(0deg, #080809 0%, transparent 27%, rgba(0,0,0,.12) 100%);
    }

    .fox-hero-grain {
        position: absolute;
        z-index: -1;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(115deg, rgba(229,9,20,.11), transparent 38%);
    }

    .fox-hero-inner {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 90px;
        padding-bottom: 100px;
    }

    .fox-hero-copy {
        width: min(610px, 62%);
        animation: foxContentReveal .8s .1s ease both;
    }

    .fox-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #ff6670;
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 2.5px;
    }

    .fox-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--fox-red-bright);
        box-shadow: 0 0 14px rgba(255,38,51,.8);
    }

    .fox-hero-copy h1 {
        margin: 22px 0 20px;
        max-width: 700px;
        font-size: clamp(42px, 5.4vw, 78px);
        font-weight: 900;
        line-height: 1.02;
        letter-spacing: -2.8px;
        overflow-wrap: anywhere;
        text-shadow: 0 5px 35px rgba(0,0,0,.4);
    }

    .fox-hero-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 14px;
        color: #dedee3;
        font-size: 12px;
        font-weight: 650;
    }

    .fox-meta-divider {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #777780;
    }

    .fox-rating,
    .fox-card-rating {
        color: #ffc45b;
    }

    .fox-hero-description {
        display: -webkit-box;
        max-width: 550px;
        margin: 22px 0 30px;
        overflow: hidden;
        color: #d0d0d6;
        font-size: 14px;
        line-height: 1.9;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 4;
    }

    .fox-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .fox-home .fox-btn {
        display: inline-flex;
        min-height: 49px;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 0 23px;
        border: 1px solid transparent;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }

        .fox-home .fox-btn:hover {
            transform: translateY(-3px);
        }

    .fox-btn-red {
        color: #fff;
        background: var(--fox-red);
        box-shadow: 0 7px 24px rgba(229,9,20,.2);
    }

        .fox-btn-red:hover {
            color: #fff;
            background: var(--fox-red-bright);
            box-shadow: 0 9px 30px rgba(229,9,20,.3);
        }

    .fox-btn-icon {
        font-size: 12px;
    }

    .fox-btn-glass {
        color: #fff;
        border-color: rgba(255,255,255,.2) !important;
        background: rgba(20,20,24,.58);
        backdrop-filter: blur(12px);
    }

        .fox-btn-glass:hover {
            color: #fff;
            border-color: rgba(255,255,255,.45) !important;
            background: rgba(40,40,46,.8);
        }

    .fox-hero-caption {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 42px;
        color: #a3a3ad;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.8px;
    }

    .fox-caption-line {
        width: 35px;
        height: 2px;
        background: var(--fox-red);
    }

    .fox-hero-index {
        position: absolute;
        right: 0;
        bottom: 88px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: rgba(255,255,255,.7);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
        writing-mode: vertical-rl;
    }

        .fox-hero-index > span:first-child {
            color: #fff;
            font-size: 15px;
        }

    .fox-index-line {
        width: 1px;
        height: 45px;
        background: var(--fox-red);
    }

    /* DISCOVERY BAR */

    .fox-main-content {
        position: relative;
    }

    .fox-discovery-bar {
        display: flex;
        min-height: 76px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 1px solid var(--fox-border);
    }

    .fox-discovery-title {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 10px;
        color: #d9d9df;
        font-size: 10px;
        font-weight: 850;
        letter-spacing: 1.5px;
    }

    .fox-discovery-mark {
        width: 5px;
        height: 20px;
        border-radius: 2px;
        background: var(--fox-red);
        box-shadow: 0 0 14px rgba(229,9,20,.45);
    }

    .fox-discovery-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 28px;
    }

        .fox-discovery-links a,
        .fox-discovery-all {
            color: var(--fox-muted);
            font-size: 12px;
            font-weight: 650;
            text-decoration: none;
            transition: color .2s ease;
        }

            .fox-discovery-links a:hover,
            .fox-discovery-all:hover {
                color: #fff;
            }

    .fox-discovery-all {
        flex-shrink: 0;
        color: #fff;
    }

        .fox-discovery-all span {
            margin-left: 7px;
            color: var(--fox-red-bright);
        }

    /* SECTIONS */

    .fox-section {
        margin-top: 53px;
        scroll-margin-top: 30px;
    }

    .fox-section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 23px;
    }

    .fox-section-kicker {
        display: block;
        color: #f34a55;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 2.1px;
    }

    .fox-section-title-wrap h2 {
        margin: 9px 0 0;
        font-size: clamp(24px, 2.5vw, 34px);
        font-weight: 850;
        line-height: 1.15;
        letter-spacing: -1px;
    }

        .fox-section-title-wrap h2 span {
            color: #85858f;
        }

    .fox-section-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .fox-see-all {
        color: #b5b5be;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: color .2s ease;
    }

        .fox-see-all:hover {
            color: #fff;
        }

        .fox-see-all span {
            padding-left: 5px;
            color: var(--fox-red-bright);
        }

    .fox-carousel-controls {
        display: flex;
        flex-shrink: 0;
        gap: 7px;
    }

        .fox-carousel-controls button {
            display: grid;
            width: 37px;
            height: 37px;
            place-items: center;
            border: 1px solid #303036;
            border-radius: 50%;
            color: #fff;
            background: #141418;
            font-size: 25px;
            line-height: 1;
            cursor: pointer;
            transition: background .2s ease, border-color .2s ease, transform .2s ease;
        }

            .fox-carousel-controls button:hover {
                transform: translateY(-2px);
                border-color: var(--fox-red);
                background: var(--fox-red);
            }

    /* MOVIE CAROUSEL */

    .fox-carousel {
        display: flex;
        gap: 18px;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 4px 3px 20px;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
        scrollbar-color: #38383f transparent;
    }

        .fox-carousel::-webkit-scrollbar {
            height: 5px;
        }

        .fox-carousel::-webkit-scrollbar-track {
            background: transparent;
        }

