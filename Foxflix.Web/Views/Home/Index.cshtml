<script>
    function foxScroll(carouselId, direction) {
        const carousel = document.getElementById(carouselId);

        if (!carousel) {
            return;
        }

        const card = carousel.querySelector(".fox-movie-card");
        const cardWidth = card ? card.getBoundingClientRect().width : 190;
        const styles = getComputedStyle(carousel);
        const gap = parseFloat(styles.gap) || 18;

        carousel.scrollBy({
            left: direction * (cardWidth + gap) * 3,
            behavior: "smooth"
        });
    }
</script>

