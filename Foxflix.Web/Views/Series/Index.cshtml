
@model List<Foxflix.Web.Controllers.SeriesController.SeriesDto>

@{
    var publicApiBaseUrl = (Configuration["ApiSettings:PublicBaseUrl"] ?? Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7283/").TrimEnd('/');
    ViewData["Title"] = "Серіали";

    var popular = ViewBag.TmdbPopularSeries
        as List<Foxflix.Web.Controllers.SeriesController.TmdbSeriesDto>
        ?? new();

    var onTheAir = ViewBag.TmdbOnTheAirSeries
        as List<Foxflix.Web.Controllers.SeriesController.TmdbSeriesDto>
        ?? new();

    var topRated = ViewBag.TmdbTopRatedSeries
        as List<Foxflix.Web.Controllers.SeriesController.TmdbSeriesDto>
        ?? new();

    var totalSeries = popular.Count + onTheAir.Count
        + topRated.Count + Model.Count;
}

<section class="series-page">
    <div class="series-container">

        <header class="series-hero">
            <div class="series-hero-content">
                <span class="series-eyebrow">
                    <span class="series-eyebrow-dot"></span>
                    FOXFLIX ORIGINALS
                </span>

                <h1>Серіали<span>.</span></h1>

                <p>
                    Відкривай нові історії, знаходь улюблені серіали
                    та обирай, що дивитися далі.
                </p>

                <div class="series-hero-meta">
                    <span class="series-meta-item">
                        <span class="series-meta-icon">▣</span>
                        Велика колекція історій
                    </span>

                    <span class="series-meta-divider"></span>

                    <span class="series-meta-item">
                        <span class="series-meta-icon">▶</span>
                        Обирай наступний серіал
                    </span>
                </div>
            </div>

            <div class="series-hero-art" aria-hidden="true">
                <div class="series-art-ring series-art-ring-one"></div>
                <div class="series-art-ring series-art-ring-two"></div>
                <div class="series-art-ring series-art-ring-three"></div>

                <div class="series-art-play">▶</div>

                <div class="series-art-caption">
                    <span>F</span>
                    <span>YOUR NEXT STORY</span>
                </div>
            </div>

            <div class="series-hero-bottom">
                <span>DISCOVER YOUR NEXT FAVORITE</span>
                <span class="series-hero-index">FOXFLIX <b> / </b> SERIES</span>
            </div>
        </header>

        @if (popular.Count > 0)
        {
            <section class="series-section">
                <div class="series-section-header">
                    <div class="series-section-title">
                        <span class="series-section-eyebrow">TRENDING NOW</span>
                        <h2>Популярні серіали</h2>
                        <p>Історії, які зараз обирають глядачі.</p>
                    </div>

                    <span class="series-count">
                        <span></span>
                        @popular.Count серіалів
                    </span>
                </div>

                <div class="series-grid">
                    @foreach (var series in popular)
                    {
                        <a asp-controller="Series"
                           asp-action="TmdbDetails"
                           asp-route-id="@series.Id"
                           class="series-card">

                            <div class="series-poster">
                                @if (!string.IsNullOrWhiteSpace(series.PosterUrl))
                                {
                                    <img src="@series.PosterUrl"
                                         alt="@series.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="series-placeholder">FOXFLIX</div>
                                }

                                <div class="series-poster-shade"></div>

                                <span class="series-poster-rating">
                                    ★ @series.VoteAverage.ToString("0.0")
                                </span>

                                <div class="series-card-overlay">
                                    <span class="series-play-button">▶</span>
                                    <span class="series-card-overlay-text">ДИВИТИСЯ ДЕТАЛІ</span>
                                </div>
                            </div>

                            <div class="series-card-info">
                                <h3>@series.Name</h3>
                                <div class="series-card-meta">
                                    <span>
                                        @(series.FirstAirDate?.Length >= 4
                                            ? series.FirstAirDate[..4]
                                            : "Рік невідомий")
                                    </span>
                                    <span class="series-meta-dot"></span>
                                    <span>Серіал</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        @if (onTheAir.Count > 0)
        {
            <section class="series-section">
                <div class="series-section-header">
                    <div class="series-section-title">
                        <span class="series-section-eyebrow">NEW EPISODES</span>
                        <h2>Зараз в ефірі</h2>
                        <p>Серіали, які продовжують виходити.</p>
                    </div>

                    <span class="series-count">
                        <span></span>
                        @onTheAir.Count серіалів
                    </span>
                </div>

                <div class="series-grid">
                    @foreach (var series in onTheAir)
                    {
                        <a asp-controller="Series"
                           asp-action="TmdbDetails"
                           asp-route-id="@series.Id"
                           class="series-card">

                            <div class="series-poster">
                                @if (!string.IsNullOrWhiteSpace(series.PosterUrl))
                                {
                                    <img src="@series.PosterUrl"
                                         alt="@series.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="series-placeholder">FOXFLIX</div>
                                }

                                <div class="series-poster-shade"></div>

                                <span class="series-poster-rating">
                                    ★ @series.VoteAverage.ToString("0.0")
                                </span>

                                <div class="series-card-overlay">
                                    <span class="series-play-button">▶</span>
                                    <span class="series-card-overlay-text">ДИВИТИСЯ ДЕТАЛІ</span>
                                </div>
                            </div>

                            <div class="series-card-info">
                                <h3>@series.Name</h3>
                                <div class="series-card-meta">
                                    <span>
                                        @(series.FirstAirDate?.Length >= 4
                                            ? series.FirstAirDate[..4]
                                            : "Рік невідомий")
                                    </span>
                                    <span class="series-meta-dot"></span>
                                    <span>Серіал</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        @if (topRated.Count > 0)
        {
            <section class="series-section">
                <div class="series-section-header">
                    <div class="series-section-title">
                        <span class="series-section-eyebrow">TOP RATED</span>
                        <h2>Найкращі за рейтингом</h2>
                        <p>Серіали з високими оцінками глядачів.</p>
                    </div>

                    <span class="series-count">
                        <span></span>
                        @topRated.Count серіалів
                    </span>
                </div>

                <div class="series-grid">
                    @foreach (var series in topRated)
                    {
                        <a asp-controller="Series"
                           asp-action="TmdbDetails"
                           asp-route-id="@series.Id"
                           class="series-card">

                            <div class="series-poster">
                                @if (!string.IsNullOrWhiteSpace(series.PosterUrl))
                                {
                                    <img src="@series.PosterUrl"
                                         alt="@series.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="series-placeholder">FOXFLIX</div>
                                }

                                <div class="series-poster-shade"></div>

                                <span class="series-poster-rating">
                                    ★ @series.VoteAverage.ToString("0.0")
                                </span>

                                <div class="series-card-overlay">
                                    <span class="series-play-button">▶</span>
                                    <span class="series-card-overlay-text">ДИВИТИСЯ ДЕТАЛІ</span>
                                </div>
                            </div>

                            <div class="series-card-info">
                                <h3>@series.Name</h3>
                                <div class="series-card-meta">
                                    <span>
                                        @(series.FirstAirDate?.Length >= 4
                                            ? series.FirstAirDate[..4]
                                            : "Рік невідомий")
                                    </span>
                                    <span class="series-meta-dot"></span>
                                    <span>Серіал</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        @if (Model.Count > 0)
        {
            <section class="series-section series-library">
                <div class="series-section-header">
                    <div class="series-section-title">
                        <span class="series-section-eyebrow">YOUR LIBRARY</span>
                        <h2>Твоя бібліотека</h2>
                        <p>Серіали, додані до колекції Foxflix.</p>
                    </div>

                    <span class="series-count">
                        <span></span>
                        @Model.Count серіалів
                    </span>
                </div>

                <div class="series-grid">
                    @foreach (var series in Model)
                    {
                        <a asp-controller="Series"
                           asp-action="Details"
                           asp-route-id="@series.Id"
                           class="series-card">

                            <div class="series-poster">
                                @if (!string.IsNullOrWhiteSpace(series.PosterPath))
                                {
                                    <img src="@($"{publicApiBaseUrl}/api/series/{series.Id}/poster")"
                                         alt="@series.Title"
                                         loading="lazy" />
                                }
                                else if (!string.IsNullOrWhiteSpace(series.PosterUrl))
                                {
                                    <img src="@series.PosterUrl"
                                         alt="@series.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="series-placeholder">FOXFLIX</div>
                                }

                                <div class="series-poster-shade"></div>

                                <span class="series-poster-rating">
                                    ★ @series.Rating
                                </span>

                                <div class="series-card-overlay">
                                    <span class="series-play-button">▶</span>
                                    <span class="series-card-overlay-text">ВІДКРИТИ СЕРІАЛ</span>
                                </div>
                            </div>

                            <div class="series-card-info">
                                <h3>@series.Title</h3>

                                <div class="series-card-meta">
                                    <span>@series.ReleaseYear</span>
                                    <span class="series-meta-dot"></span>
                                    <span>@series.Genre</span>
                                </div>

                                <div class="series-seasons">
                                    <span>▤</span>
                                    @series.SeasonsCount сезон(и)
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        @if (totalSeries == 0)
        {
            <div class="series-empty">
                <div class="series-empty-icon">▶</div>
                <span class="series-section-eyebrow">FOXFLIX LIBRARY</span>
                <h2>Тут поки тихо</h2>
                <p>
                    Не вдалося завантажити серіали.
                    Спробуй оновити сторінку трохи пізніше.
                </p>
                <a asp-controller="Series"
                   asp-action="Index"
                   class="series-empty-button">
                    Оновити сторінку <span>↻</span>
                </a>
            </div>
        }

        <footer class="series-footer">
            <span class="series-footer-logo">FOXFLIX<span>.</span></span>
            <span>ТВОЯ ІСТОРІЯ ПОЧИНАЄТЬСЯ ТУТ</span>
        </footer>

    </div>
</section>

<style>
    .series-page {
        min-height: 100vh;
        padding: 35px 28px 45px;
        background: radial-gradient(ellipse at 90% 0%, rgba(229, 9, 20, .07), transparent 30%), #080808;
        color: #f5f5f5;
    }

    .series-container {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
    }

    .series-page * {
        box-sizing: border-box;
    }

    .series-hero {
        position: relative;
        display: flex;
        min-height: 340px;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        border: 1px solid #302020;
        border-radius: 17px;
        background: radial-gradient(ellipse at 78% 43%, rgba(229, 9, 20, .18), transparent 33%), linear-gradient(110deg, #171011 0%, #100d0e 54%, #190b0c 100%);
    }

    .series-hero-content {
        position: relative;
        z-index: 2;
        max-width: 650px;
        padding: 38px 40px 28px;
    }

    .series-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: #ff424b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2.5px;
    }

    .series-eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #e50914;
        box-shadow: 0 0 12px rgba(229, 9, 20, .6);
    }

    .series-hero h1 {
        margin: 18px 0 12px;
        font-size: clamp(44px, 6vw, 68px);
        line-height: 1;
        font-weight: 850;
        letter-spacing: -3px;
    }

        .series-hero h1 span {
            color: #e50914;
        }

    .series-hero-content > p {
        max-width: 490px;
        margin: 0;
        color: #aaa;
        font-size: 14px;
        line-height: 1.9;
    }

    .series-hero-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 27px;
    }

    .series-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: #bcbcbc;
        font-size: 11px;
    }

    .series-meta-icon {
        color: #f0444d;
        font-size: 15px;
    }

    .series-meta-divider {
        width: 1px;
        height: 15px;
        background: #393030;
    }

    .series-hero-art {
        position: absolute;
        top: 0;
        right: 0;
        width: 43%;
        height: 100%;
        pointer-events: none;
    }

    .series-art-ring {
        position: absolute;
        top: 45%;
        left: 55%;
        aspect-ratio: 1;
        border: 1px solid rgba(255, 80, 90, .16);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }

    .series-art-ring-one {
        width: 310px;
        box-shadow: 0 0 80px rgba(229, 9, 20, .07);
    }

    .series-art-ring-two {
        width: 230px;
        border-color: rgba(255, 80, 90, .24);
    }

    .series-art-ring-three {
        width: 150px;
        border-color: rgba(255, 80, 90, .36);
    }

    .series-art-play {
        position: absolute;
        top: 45%;
        left: 55%;
        display: grid;
        width: 86px;
        height: 86px;
        place-items: center;
        padding-left: 5px;
        border: 1px solid rgba(255,255,255,.17);
        border-radius: 26px;
        background: linear-gradient(145deg, #ed1722, #80060c);
        box-shadow: 0 15px 55px rgba(229, 9, 20, .27);
        color: white;
        font-size: 27px;
        transform: translate(-50%, -50%) rotate(-8deg);
    }

    .series-art-caption {
        position: absolute;
        right: 38px;
        bottom: 63px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #716263;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.8px;
    }

        .series-art-caption span:first-child {
            color: #e50914;
            font-size: 26px;
            font-weight: 900;
        }

    .series-hero-bottom {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 25px;
        border-top: 1px solid rgba(255,255,255,.07);
        color: #76696a;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.6px;
    }

    .series-hero-index {
        color: #aaa;
    }

        .series-hero-index b {
            padding: 0 5px;
            color: #e50914;
        }

    .series-section {
        margin-top: 49px;
    }

    .series-section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 23px;
    }

    .series-section-title {
        min-width: 0;
    }

    .series-section-eyebrow {
        color: #e50914;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2.2px;
    }

    .series-section-title h2 {
        margin: 9px 0 7px;
        font-size: clamp(23px, 2.7vw, 30px);
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -.8px;
    }

    .series-section-title p {
        margin: 0;
        color: #858585;
        font-size: 12px;
        line-height: 1.7;
    }

    .series-count {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        gap: 8px;
        padding: 9px 11px;
        border: 1px solid #292929;
        border-radius: 7px;
        color: #aaa;
        font-size: 10px;
        white-space: nowrap;
    }

        .series-count > span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #e50914;
            box-shadow: 0 0 8px rgba(229, 9, 20, .4);
        }

    .series-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 27px 17px;
    }

    .series-card {
        display: block;
        min-width: 0;
        border: 1px solid transparent;
        border-radius: 12px;
        color: inherit;
        text-decoration: none;
        transition: transform .25s ease, border-color .25s ease;
    }

        .series-card:hover {
            transform: translateY(-5px);
        }

    .series-poster {
        position: relative;
        overflow: hidden;
        aspect-ratio: 2 / 3;
        border: 1px solid #242424;
        border-radius: 11px;
        background: #141414;
        isolation: isolate;
    }

        .series-poster > img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease, filter .3s ease;
        }

    .series-card:hover .series-poster > img {
        transform: scale(1.055);
        filter: brightness(.72);
    }

    .series-placeholder {
        display: flex;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 40%, rgba(229,9,20,.15), transparent 48%), #111;
        color: #e50914;
        font-size: 15px;
        font-weight: 900;
        letter-spacing: 3px;
    }

    .series-poster-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient( to bottom, rgba(0,0,0,.32) 0%, transparent 24%, transparent 57%, rgba(0,0,0,.42) 100% );
        pointer-events: none;
    }

    .series-poster-rating {
        position: absolute;
        top: 10px;
        left: 10px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 8px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 6px;
        background: rgba(8,8,8,.78);
        color: #f3f3f3;
        font-size: 10px;
        font-weight: 750;
        backdrop-filter: blur(8px);
    }

    .series-card-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: rgba(0,0,0,.12);
        opacity: 0;
        transition: opacity .25s ease;
    }

    .series-card:hover .series-card-overlay,
    .series-card:focus-visible .series-card-overlay {
        opacity: 1;
    }

    .series-play-button {
        display: grid;
        width: 48px;
        height: 48px;
        place-items: center;
        padding-left: 3px;
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 50%;
        background: #e50914;
        box-shadow: 0 6px 25px rgba(229,9,20,.3);
        color: white;
        font-size: 15px;
        transition: transform .2s ease;
    }

    .series-card:hover .series-play-button {
        transform: scale(1.08);
    }

    .series-card-overlay-text {
        color: white;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-align: center;
    }

    .series-card-info {
        padding: 12px 2px 0;
    }

        .series-card-info h3 {
            display: -webkit-box;
            overflow: hidden;
            margin: 0 0 8px;
            color: #eee;
            font-size: 13px;
            font-weight: 700;
            line-height: 1.5;
            overflow-wrap: anywhere;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            transition: color .2s ease;
        }

    .series-card:hover .series-card-info h3 {
        color: #ff454d;
    }

    .series-card-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        color: #909090;
        font-size: 10px;
        line-height: 1.6;
    }

    .series-meta-dot {
        width: 3px;
        height: 3px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e50914;
    }

    .series-seasons {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 8px;
        color: #999;
        font-size: 10px;
    }

        .series-seasons span {
            color: #e50914;
            font-size: 13px;
        }

    .series-library {
        padding-top: 30px;
        border-top: 1px solid #222;
    }

    .series-empty {
        display: flex;
        min-height: 330px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-top: 45px;
        padding: 35px 22px;
        border: 1px solid #292020;
        border-radius: 15px;
        background: radial-gradient(ellipse at 50% 20%, rgba(229,9,20,.1), transparent 55%), #101010;
        text-align: center;
    }

    .series-empty-icon {
        display: grid;
        width: 65px;
        height: 65px;
        place-items: center;
        margin-bottom: 22px;
        padding-left: 4px;
        border: 1px solid #422124;
        border-radius: 20px;
        background: rgba(229,9,20,.1);
        color: #e50914;
        font-size: 22px;
    }

    .series-empty h2 {
        margin: 12px 0 8px;
        font-size: 25px;
        font-weight: 800;
    }

    .series-empty p {
        max-width: 420px;
        margin: 0;
        color: #929292;
        font-size: 13px;
        line-height: 1.8;
    }

    .series-empty-button {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-top: 22px;
        padding: 12px 16px;
        border: 1px solid #e50914;
        border-radius: 8px;
        background: #e50914;
        color: white;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: background .2s ease;
    }

        .series-empty-button:hover {
            background: #b80710;
        }

        .series-empty-button span {
            font-size: 17px;
        }

    .series-footer {
        display: flex;
        justify-content: space-between;
