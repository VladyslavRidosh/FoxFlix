
@model Foxflix.Web.Controllers.SearchController.TmdbSearchResponse

@{
    ViewData["Title"] = "Пошук";
    string query = ViewBag.Query as string ?? "";
    int currentPage = ViewBag.Page ?? 1;
}

<div class="search-page">
    <header class="search-header">
        <span class="search-eyebrow">FOXFLIX DISCOVERY</span>
        <h1>Пошук фільмів</h1>
        <p>Знайди наступний фільм для перегляду.</p>

        <form asp-controller="Search" asp-action="Index" method="get"
              class="search-page-form">
            <input type="search"
                   name="query"
                   value="@query"
                   placeholder="Назва фільму..."
                   aria-label="Назва фільму"
                   required />
            <button type="submit">Знайти</button>
        </form>
    </header>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
    {
        <div class="search-message search-error">
            @ViewBag.Error
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(query))
    {
        <section class="search-results">
            <div class="search-results-heading">
                <div>
                    <span class="search-eyebrow">РЕЗУЛЬТАТИ TMDB</span>
                    <h2>Результати для «@query»</h2>
                </div>
                <span class="search-results-count">
                    @Model.TotalResults фільмів
                </span>
            </div>

            @if (Model.Results.Count == 0)
            {
                <div class="search-message">
                    <h3>Нічого не знайдено</h3>
                    <p>Спробуй іншу назву або пошуковий запит.</p>
                </div>
            }
            else
            {
                <div class="search-movie-grid">
                    @foreach (var movie in Model.Results)
                    {
                        <article class="search-movie-card">
                            <a asp-controller="Movies"
                               asp-action="TmdbDetails"
                               asp-route-id="@movie.Id"
                               class="search-movie-poster">
                                @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl"
                                         alt="@movie.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="search-no-poster">
                                        ПОСТЕР НЕДОСТУПНИЙ
                                    </div>
                                }

                                <span class="search-movie-rating">
                                    ★ @movie.VoteAverage.ToString("0.0")
                                </span>
                            </a>

                            <div class="search-movie-info">
                                <h3>
                                    <a asp-controller="Movies"
                                       asp-action="TmdbDetails"
                                       asp-route-id="@movie.Id">
                                        @movie.Title
                                    </a>
                                </h3>

                                <span class="search-movie-year">
                                    @movie.ReleaseYear
                                </span>

                                <p>
                                    @(string.IsNullOrWhiteSpace(movie.Overview)
                                        ? "Опис поки недоступний."
                                        : movie.Overview)
                                </p>
                            </div>
                        </article>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="search-pagination" aria-label="Сторінки пошуку">
                        @if (currentPage > 1)
                        {
                            <a asp-action="Index"
                               asp-route-query="@query"
                               asp-route-page="@(currentPage - 1)">
                                ← Назад
                            </a>
                        }

                        <span>Сторінка @currentPage з @Model.TotalPages</span>

                        @if (currentPage < Model.TotalPages)
                        {
                            <a asp-action="Index"
                               asp-route-query="@query"
                               asp-route-page="@(currentPage + 1)">
                                Далі →
                            </a>
                        }
                    </nav>
                }
            }
        </section>
    }
</div>

<style>
    .search-page {
        max-width: 1500px;
        min-height: 70vh;
        margin: 0 auto;
        padding: 55px 4% 80px;
        color: #f5f5f5;
    }

    .search-header {
        margin-bottom: 55px;
    }

    .search-eyebrow {
        color: #e50914;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
    }

    .search-header h1 {
        margin: 12px 0;
        font-size: clamp(32px, 5vw, 54px);
        font-weight: 800;
    }

    .search-header > p {
        color: #999;
        margin-bottom: 25px;
    }

    .search-page-form {
        display: flex;
        gap: 10px;
        max-width: 650px;
    }

    .search-page-form input {
        flex: 1;
        min-width: 0;
        padding: 15px 18px;
        color: white;
        background: #151515;
        border: 1px solid #353535;
        border-radius: 8px;
        outline: none;
    }

    .search-page-form input:focus {
        border-color: #e50914;
    }

    .search-page-form button {
        padding: 0 25px;
        border: 0;
        border-radius: 8px;
        background: #e50914;
        color: white;
        font-weight: 800;
        cursor: pointer;
    }

    .search-results-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .search-results-heading h2 {
        margin: 8px 0 0;
        font-size: clamp(20px, 3vw, 28px);
    }

    .search-results-count,
    .search-movie-year {
        color: #999;
        font-size: 13px;
    }

    .search-movie-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 28px 18px;
    }

    .search-movie-card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid #252525;
        border-radius: 10px;
        background: #111;
        transition: transform .2s, border-color .2s;
    }

    .search-movie-card:hover {
        transform: translateY(-5px);
        border-color: #e50914;
    }

    .search-movie-poster {
        position: relative;
        display: block;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background: #1b1b1b;
    }

    .search-movie-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .3s;
    }

    .search-movie-card:hover .search-movie-poster img {
        transform: scale(1.04);
    }

    .search-movie-rating {
        position: absolute;
        right: 10px;
        top: 10px;
        padding: 6px 9px;
        border-radius: 6px;
        background: rgba(0, 0, 0, .85);
        color: #ffd166;
        font-size: 12px;
        font-weight: 800;
    }

    .search-no-poster {
        display: grid;
        height: 100%;
        place-items: center;
        padding: 12px;
        color: #777;
        text-align: center;
        font-size: 12px;
    }

    .search-movie-info {
        padding: 14px;
    }

    .search-movie-info h3 {
        margin: 0 0 8px;
        font-size: 16px;
        line-height: 1.4;
    }

    .search-movie-info h3 a {
        color: #fff;
        text-decoration: none;
    }

    .search-movie-info h3 a:hover {
        color: #e50914;
    }

    .search-movie-info p {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        margin: 12px 0 0;
        color: #aaa;
        font-size: 12px;
        line-height: 1.6;
    }

    .search-message {
        padding: 40px 20px;
        border: 1px solid #252525;
        border-radius: 10px;
        background: #111;
        text-align: center;
    }

    .search-message p {
        color: #999;
    }

    .search-error {
        border-color: #76252a;
    }

    .search-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 40px;
        color: #aaa;
    }

    .search-pagination a {
        padding: 10px 16px;
        border: 1px solid #333;
        border-radius: 7px;
        color: white;
        text-decoration: none;
    }

    .search-pagination a:hover {
        border-color: #e50914;
    }

    @@media (max-width: 1100px) {
        .search-movie-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 750px) {
        .search-movie-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .search-page {
            padding: 35px 16px 60px;
        }

        .search-movie-info {
            padding: 10px;
        }

        .search-results-heading {
            align-items: start;
            flex-direction: column;
        }
    }

    @@media (max-width: 380px) {
        .search-page-form {
            flex-direction: column;
        }

        .search-page-form button {
            min-height: 44px;
        }
    }
</style>

