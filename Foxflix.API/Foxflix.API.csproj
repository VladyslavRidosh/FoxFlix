<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>740ab656-e6a7-4e8a-9538-779f5b20c4c5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foxflix.Infrastructure\Foxflix.Infrastructure.csproj" />
    <ProjectReference Include="..\Netflix.Application\Foxflix.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\Sql\postgresql-domain-schema.sql" />
    <EmbeddedResource Include="Database\Sql\postgresql-identity-schema.sql" />
  </ItemGroup>

</Project>
